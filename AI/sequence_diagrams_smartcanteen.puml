participant "Backend API\n/api/admin/logs" as API
participant "JWT Auth + RBAC" as Auth
participant "Logging Admin Query Handler" as Handler
database "Database" as DB

Admin -> FE: Open API logs
FE -> API: GET /api/admin/logs\nAuthorization: Bearer JWT
API -> Auth: Validate JWT + Role=Admin
alt Unauthorized or forbidden
    API --> FE: 401/403
else Authorized
    API -> Handler: ListApiLogsQuery
    Handler -> DB: Query ApiLogs with filters/pagination
    API --> FE: 200 paginated logs
end

Admin -> FE: View log detail
FE -> API: GET /api/admin/logs/{id}\nAuthorization: Bearer JWT
API -> Auth: Validate JWT + Role=Admin
API -> Handler: GetApiLogDetailQuery
alt Log not found
    API --> FE: 404
else Found
    Handler -> DB: Load ApiLog detail
    API --> FE: 200 log detail
end
@enduml

@startuml
title Change Proposal after Session Finalization

actor Manager
actor User
participant "Mobile App / Web App" as FE
participant "Backend API" as API
participant "JWT Auth" as Auth
participant "FinalizeSessionCommandHandler" as Finalize
participant "ChangeProposal Handler" as Proposal
participant "Notification Service" as Noti
database "Database" as DB

Manager -> API: POST /api/sessions/{id}/finalize\nAuthorization: Bearer JWT\n{preparedDishes}
API -> Auth: Validate JWT
API -> Finalize: FinalizeSessionCommand
Finalize -> DB: Begin transaction
Finalize -> DB: Compare paid order items\nwith prepared quantities
alt All items available
    Finalize -> DB: Mark session finalized
    Finalize -> DB: Commit
    API --> Manager: 200 finalized
else Some items unavailable
    Finalize -> DB: Mark affected order items ChangePending
    Finalize -> DB: Create OrderItemChangeProposal
    Finalize -> DB: Commit
    Finalize -> Noti: Notify affected users
    API --> Manager: 200 finalized with proposals
end

User -> FE: Accept replacement proposal
FE -> API: POST /api/changeproposals/{id}/accept\nAuthorization: Bearer JWT
API -> Auth: Validate JWT
API -> Proposal: AcceptChangeProposalCommand
alt Proposal invalid/expired
    API --> FE: 400/404
else Accepted
    Proposal -> DB: Update order item to replacement dish
    Proposal -> DB: Mark proposal Accepted
    API --> FE: 200 accepted
end

User -> FE: Request refund from proposal
FE -> API: POST /api/changeproposals/{id}/request-refund\nAuthorization: Bearer JWT
API -> Proposal: RequestRefundFromProposalCommand
alt Proposal invalid
    API --> FE: 400/404
else Refund requested
    Proposal -> DB: Create RefundRequest from proposal
    Proposal -> DB: Mark proposal refund requested
    API --> FE: 200 refund request created
end
@enduml

