@startuml
title Create Robot Serving Job

actor Staff
participant "Web App / Backend Internal Flow" as FE
participant "Backend API\nPOST /api/robot/serving-jobs" as API
participant "JWT Auth" as Auth
participant "CreateServingJobCommandHandler" as Handler
participant "SignalR ServingJobNotifier" as SignalR
participant "Robot Service" as RobotService
database "Database" as DB

Staff -> FE: Create serving job for paid order
FE -> API: POST /api/robot/serving-jobs\nAuthorization: Bearer JWT\n{orderId,trayId?}
API -> Auth: Validate JWT
API -> Handler: CreateServingJobCommand
Handler -> DB: Load order with items
alt Order not found
    API --> FE: 404/400
else Existing active job
    Handler -> DB: Return existing job
    API --> FE: 200 existing serving job
else New job
    Handler -> DB: Select available tray or specified tray
    Handler -> DB: Create ServingJob status=Pushed
    Handler -> DB: Reserve tray
    Handler -> DB: Update order status=Preparing\nadd status history
    Handler -> DB: Save changes
    Handler -> SignalR: Push ServingJobMessage
    SignalR -> RobotService: jobId, orderId, tray, items
    alt SignalR push failed
        Handler --> API: 200 job saved\npush failure logged
    else Push succeeded
        Handler --> API: 200 job created and pushed
    end
end
@enduml

@startuml
title Robot Report Serving Status

participant "Robot Service" as RobotService
