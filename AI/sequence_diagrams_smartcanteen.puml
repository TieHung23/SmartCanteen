@startuml
title Manager Create / Update / Finalize Session

actor Manager
participant "Web App" as FE
participant "Backend API\n/api/sessions" as API
participant "JWT Auth" as Auth
participant "Session Command Handler" as Handler
participant "Notification Service" as Noti
database "Database" as DB

Manager -> FE: Submit session form
FE -> API: POST /api/sessions\nAuthorization: Bearer JWT\n{session, templates, dishes}
API -> Auth: Validate JWT
note right of API
Current controller uses [Authorize].
Business flow expects Manager.
end note
API -> Handler: CreateSessionCommand
Handler -> DB: Validate referenced dishes/categories
alt Invalid request
    API --> FE: 400
else Valid
    Handler -> DB: Save Session + MealTemplates + Settings + SessionDishes
    API --> FE: 201 created
end

Manager -> FE: Update session
FE -> API: PUT /api/sessions/{id}\nAuthorization: Bearer JWT
API -> Handler: UpdateSessionCommand
alt Route id != body id or invalid
    API --> FE: 400
else Valid
    Handler -> DB: Update session aggregate
    API --> FE: 200 updated
end

Manager -> FE: Finalize prepared quantities
FE -> API: POST /api/sessions/{id}/finalize\n{preparedDishes}
API -> Handler: FinalizeSessionCommand
Handler -> DB: Begin transaction
Handler -> DB: Compare ordered quantities vs prepared quantities
alt Under-supplied items
    Handler -> DB: Create change proposals\nmark affected items ChangePending
    Handler -> Noti: Notify users
    Handler -> DB: Commit
    API --> FE: 200 finalized with proposals
else Enough stock
    Handler -> DB: Mark session finalized
    Handler -> DB: Commit
    API --> FE: 200 finalized
else Error
    Handler -> DB: Rollback
    API --> FE: 500
end
@enduml

