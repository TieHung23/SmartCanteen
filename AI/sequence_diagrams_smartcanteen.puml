@startuml
title SePay IPN Webhook Confirmation

participant "SePay Gateway" as SePay
participant "Backend API\nPOST /api/payments/sepay/ipn" as API
participant "SePay Webhook Verifier" as Verifier
participant "HandleSepayIpnCommandHandler" as Handler
participant "PaymentService" as Payment
participant "Notification Service" as Noti
database "Database" as DB

SePay -> API: POST /api/payments/sepay/ipn\nX-SePay-Timestamp\nX-SePay-Signature\nraw JSON
API -> Verifier: Verify HMAC signature\nsha256={timestamp}.{raw_body}
alt Invalid signature or stale timestamp
    API --> SePay: 401
else Valid signature
    API -> Handler: HandleSepayIpnCommand
    Handler -> Payment: HandleSepayIpnAsync
    Payment -> DB: Begin transaction
    Payment -> DB: Find Payment by gatewayOrderId/content
    alt Payment not found or invalid payload
        Payment -> DB: Rollback
        API --> SePay: 400
    else Already completed
        Payment -> DB: Commit/no-op
        API --> SePay: {success:true}
    else Pending payment matched
        Payment -> DB: Mark Payment Completed
        Payment -> DB: Credit user wallet
        Payment -> DB: Create WalletTransaction\nType=TopUp, amount positive
        Payment -> DB: Commit
        Handler -> Noti: Notify payment completed
        API --> SePay: {success:true}
    else Error
        Payment -> DB: Rollback
        API --> SePay: 400
    end
end
@enduml

