participant "JWT Auth" as Auth
participant "ReportServingStatusCommandHandler" as Handler
participant "SignalR RobotHub" as SignalR
participant "Notification Service" as Noti
database "Database" as DB

RobotService -> API: Report serving status\nAuthorization: Bearer JWT\n{jobId,status,event}
API -> Auth: Validate JWT
API -> Handler: ReportServingStatusCommand
Handler -> DB: Load serving job/order/tray
alt Job not found or invalid transition
    API --> RobotService: 400/404
else Status update valid
    Handler -> DB: Update ServingJob status\nAssembling/OnShelf/Failed/Collected
    Handler -> DB: Add RobotEventLog
    alt Robot failed
        Handler -> Noti: Notify Staff
        Handler -> SignalR: Publish robot error
        API --> RobotService: 200 failure recorded
    else On shelf
        Handler -> DB: Update order status=ReadyForPickup/InHoldingArea
        Handler -> SignalR: Publish job update
        Handler -> Noti: Notify user ready
        API --> RobotService: 200 status recorded
    else Other status
        Handler -> SignalR: Publish job update
        API --> RobotService: 200 status recorded
    end
end
@enduml

