@startuml
title Register Account

actor User
participant "Mobile App / Web App" as FE
participant "Backend API\nPOST /api/auth/register" as API
participant "RegisterUserCommandHandler" as Handler
participant "Email Service" as Email
database "Database" as DB

User -> FE: Submit registration form
FE -> API: POST /api/auth/register\n{name,email,password,...}
API -> Handler: Validate request
Handler -> DB: Check duplicate email/studentId
alt Invalid or duplicate
    Handler --> API: Result failure
    API --> FE: 400 error
else Valid
    Handler -> DB: Create User\nstatus=PendingEmailVerification
    Handler -> DB: Create EmailVerificationToken
    Handler -> Email: Send verification code
    alt Email send failed
        Handler --> API: 201 user persisted\nwith warning/log
    else Email sent
        Handler --> API: 201 registered
    end
    API --> FE: Result<RegisterUserResponse>
end
FE --> User: Show next step
@enduml

@startuml
title Verify Email

actor User
participant "Mobile App / Web App" as FE
participant "Backend API\nPOST /api/auth/verify-email" as API
participant "VerifyEmailCommandHandler" as Handler
database "Database" as DB

User -> FE: Enter verification code
FE -> API: POST /api/auth/verify-email\n{email, code}
API -> Handler: Validate request
Handler -> DB: Find active email verification token
alt Token invalid or expired
    Handler --> API: Result failure
    API --> FE: 400 invalid/expired code
else Token valid
    Handler -> DB: Mark token consumed
    Handler -> DB: Update user status\nPendingIdentityVerification
    API <-- Handler: Result success
    API --> FE: 200 verified
end
FE --> User: Show identity verification step
@enduml

@startuml
title Login / Logout / Refresh Token

actor User
participant "Mobile App / Web App" as FE
participant "Backend API" as API
participant "Auth Command Handler" as Auth
database "Database" as DB

User -> FE: Login
FE -> API: POST /api/auth/login\n{email,password}
API -> Auth: Validate credentials
Auth -> DB: Load user + refresh tokens
alt Invalid credentials or banned/suspended
    Auth --> API: Result failure
    API --> FE: 400/401
else Valid
    Auth -> DB: Create refresh token
    Auth --> API: accessToken, refreshToken,\nisFullyVerified
    API --> FE: 200 tokens
end

FE -> API: POST /api/auth/refresh\n{refreshToken}
API -> Auth: Validate refresh token
alt Refresh token invalid
    API --> FE: 400/401
else Refresh token valid
    Auth -> DB: Rotate refresh token
    API --> FE: 200 new tokens
end

FE -> API: POST /api/auth/logout\nAuthorization: Bearer JWT
API -> Auth: Revoke refresh token/session
Auth -> DB: Mark token revoked
API --> FE: 200 logged out
@enduml

@startuml
title Forgot Password / Reset Password

actor User
participant "Mobile App / Web App" as FE
participant "Backend API" as API
participant "Auth Command Handler" as Auth
participant "Email Service" as Email
database "Database" as DB

User -> FE: Request password reset
FE -> API: POST /api/auth/forgot-password\n{email}
API -> Auth: Validate email
Auth -> DB: Find user
alt User not found
    Auth --> API: Generic success response
else User found
    Auth -> DB: Create PasswordResetToken
    Auth -> Email: Send reset code/link
    Auth --> API: Success
end
API --> FE: 200

User -> FE: Submit reset code and new password
FE -> API: POST /api/auth/reset-password\n{email,token,newPassword}
API -> Auth: Validate password rules and token
Auth -> DB: Load active reset token
alt Token invalid or expired
    API --> FE: 400 invalid token
else Valid
    Auth -> DB: Update password hash
    Auth -> DB: Consume reset token
    API --> FE: 200 password reset
end
@enduml

@startuml
title Submit Identity Verification Request

actor User
participant "Mobile App / Web App" as FE
participant "Backend API\nPOST /api/verification/submit" as API
participant "JWT Auth" as Auth
participant "SubmitVerificationCommandHandler" as Handler
participant "File Validator" as FileValidator
participant "Cloudinary Storage" as Storage
participant "Notification Service" as Noti
database "Database" as DB

User -> FE: Upload identity documents
FE -> API: POST /api/verification/submit\nAuthorization: Bearer JWT\nmultipart files + documentTypes
API -> Auth: Validate JWT
Auth --> API: userId
API -> Handler: SubmitVerificationCommand
Handler -> DB: Load user and pending requests
alt Account not PendingIdentityVerification\nor pending request exists
    Handler --> API: Result failure
    API --> FE: 400
else Eligible
    loop Each file
        Handler -> FileValidator: Validate name, size, MIME
        alt Invalid file
            Handler --> API: Result failure
            API --> FE: 400
        else Valid
            Handler -> Storage: Upload file
            Storage --> Handler: cloudinaryUrl
        end
    end
    Handler -> DB: Save VerificationRequest + documents
    Handler -> Noti: Notify managers
    API <-- Handler: 201 requestId
    API --> FE: 201 submitted
end
@enduml

@startuml
title Manager Review Identity Verification

