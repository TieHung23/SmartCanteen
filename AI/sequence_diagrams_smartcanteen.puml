@startuml
title User Update Cart

actor User
participant "Mobile App / Web App" as FE
participant "Backend API\nPUT /api/cart" as API
participant "JWT Auth" as Auth
participant "UpdateCartCommandHandler" as Handler
participant "CartValidationService" as CartValidation
database "Database" as DB

User -> FE: Add/update dish quantity
FE -> API: PUT /api/cart\nAuthorization: Bearer JWT\n{data, expectedVersion}
API -> Auth: Validate JWT
API -> Handler: UpdateCartCommand
Handler -> CartValidation: Validate session/template/dishes\nand order deadline
alt Validation failed
    API --> FE: 400 validation error
else Valid
    Handler -> DB: Begin transaction
    Handler -> DB: Lock user/cart row
    Handler -> DB: Load current cart
    alt expectedVersion mismatch
        Handler -> DB: Rollback
        API --> FE: 409 CartVersionConflict
    else Version matches
        Handler -> DB: Create/update cart JSON\nincrement version
        Handler -> DB: Commit
        API --> FE: 200 {version, updatedAtUtc}
    else Error
        Handler -> DB: Rollback
        API --> FE: 500
    end
end
@enduml

@startuml
title User Place Order using Wallet

actor User
participant "Mobile App / Web App" as FE
participant "Backend API\nPOST /api/orders" as API
participant "JWT Auth" as Auth
participant "CreateOrderCommandHandler" as Handler
participant "CartValidationService" as CartValidation
participant "WalletDomainService" as Wallet
participant "Notification Service" as Noti
participant "Robot Serving Handler" as Robot
database "Database" as DB

User -> FE: Checkout selected session
FE -> API: POST /api/orders\nAuthorization: Bearer JWT\n{sessionId, cartVersion}
API -> Auth: Validate JWT
API -> Handler: CreateOrderCommand
Handler -> DB: Begin transaction
Handler -> Wallet: Lock user balance
Handler -> DB: Load cart
alt Cart missing or version conflict
    Handler -> DB: Rollback
    API --> FE: 400/409
else Cart exists
    Handler -> CartValidation: Validate active session, deadline,\ntemplate rules, dish stock
    alt Validation failed
        Handler -> DB: Rollback
        API --> FE: 400
    else Valid
        Handler -> DB: Load user balance
        alt Insufficient balance
            Handler -> DB: Rollback
            API --> FE: 400 insufficient balance
        else Enough balance
            Handler -> Wallet: Debit user balance
            Handler -> DB: Create WalletTransaction\nType=OrderPayment, amount negative
            Handler -> DB: Create Order + OrderItems\nattach transactionId
            Handler -> DB: Remove checked-out session from cart
            Handler -> DB: Commit
            Handler -> Noti: Notify order created
            Handler -> Robot: CreateServingJobCommand\nbest effort
            API --> FE: 201 order created and wallet debited
        else Error
            Handler -> DB: Rollback
            API --> FE: 500
        end
    end
end
@enduml

